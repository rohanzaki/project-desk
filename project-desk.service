[Unit]
Description=Project Desk shared Codex and Claude coordination
After=network.target

[Service]
Type=simple
WorkingDirectory=project-desk
ExecStart=.venv/bin/python server.py
Environment=PROJECT_DESK_STRICT=1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
